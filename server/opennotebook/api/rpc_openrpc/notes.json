{
 "components": {
  "schemas": {
   "NoteCitation": {
    "properties": {
     "excerpt": {
      "description": "the passage the claim rests on",
      "type": "string"
     },
     "n": {
      "description": "the number used in the notes, [1], [2], in reading order",
      "type": "integer"
     },
     "name": {
      "description": "the source's file name, as source_list names it",
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "description": "empty for a note or a research report",
      "type": "string"
     }
    },
    "required": [
     "n",
     "name",
     "title",
     "url",
     "excerpt"
    ],
    "type": "object"
   },
   "NoteIdea": {
    "properties": {
     "body": {
      "description": "Markdown with [n] markers",
      "type": "string"
     },
     "heading": {
      "type": "string"
     }
    },
    "required": [
     "heading",
     "body"
    ],
    "type": "object"
   },
   "NoteQuestion": {
    "properties": {
     "answer": {
      "description": "with [n] markers; empty when the model wrote no answer for it",
      "type": "string"
     },
     "question": {
      "type": "string"
     }
    },
    "required": [
     "question",
     "answer"
    ],
    "type": "object"
   },
   "NoteTerm": {
    "properties": {
     "definition": {
      "description": "with [n] markers",
      "type": "string"
     },
     "term": {
      "type": "string"
     }
    },
    "required": [
     "term",
     "definition"
    ],
    "type": "object"
   },
   "NotesCreateReq": {
    "properties": {
     "focus": {
      "description": "a topic to centre the notes on, in the person's words",
      "type": "string"
     },
     "sid": {
      "description": "a collection's cid, from collection_create",
      "type": "string"
     },
     "sources": {
      "description": "source names from source_list; every source when absent",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sid"
    ],
    "type": "object"
   },
   "NotesEstimate": {
    "description": "What notes_create would cost, before it runs. One model call over the\nsources' whole text; a second one only when the first comes back without its\nsections.",
    "properties": {
     "chars": {
      "description": "readable text across the sources",
      "type": "integer"
     },
     "cost_high_usd": {
      "description": "two calls, when the first comes back without its sections",
      "type": "number"
     },
     "cost_usd": {
      "description": "one call, the usual case",
      "type": "number"
     },
     "input_tokens": {
      "description": "estimated at four characters a token, prompt and passage numbers included",
      "type": "integer"
     },
     "model": {
      "type": "string"
     },
     "output_tokens": {
      "description": "typical notes",
      "type": "integer"
     },
     "priced": {
      "description": "false when the price catalog had no price for the model; the costs are then 0",
      "type": "boolean"
     },
     "sources": {
      "type": "integer"
     }
    },
    "required": [
     "sources",
     "chars",
     "model",
     "input_tokens",
     "output_tokens",
     "cost_usd",
     "cost_high_usd",
     "priced"
    ],
    "type": "object"
   },
   "NotesListResult": {
    "properties": {
     "notes": {
      "description": "newest first",
      "items": {
       "$ref": "#/components/schemas/StudyNotesSummary"
      },
      "type": "array"
     }
    },
    "required": [
     "notes"
    ],
    "type": "object"
   },
   "NotesRef": {
    "properties": {
     "id": {
      "type": "string"
     },
     "sid": {
      "type": "string"
     }
    },
    "required": [
     "sid",
     "id"
    ],
    "type": "object"
   },
   "NotesRetitleReq": {
    "properties": {
     "id": {
      "type": "string"
     },
     "sid": {
      "type": "string"
     },
     "title": {
      "description": "the new name, trimmed; empty is refused",
      "type": "string"
     }
    },
    "required": [
     "sid",
     "id",
     "title"
    ],
    "type": "object"
   },
   "StudyNotes": {
    "properties": {
     "citations": {
      "items": {
       "$ref": "#/components/schemas/NoteCitation"
      },
      "type": "array"
     },
     "created_ms": {
      "type": "integer"
     },
     "dropped": {
      "description": "citations removed: a number naming no passage, or a passage that does not say the claim",
      "type": "integer"
     },
     "essays": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "excerpted": {
      "description": "the sources were too long to send whole and were cut to excerpts",
      "type": "boolean"
     },
     "focus": {
      "description": "what the person asked them to centre on; empty when nothing",
      "type": "string"
     },
     "glossary": {
      "description": "alphabetical",
      "items": {
       "$ref": "#/components/schemas/NoteTerm"
      },
      "type": "array"
     },
     "id": {
      "description": "a UUID, the notes' own address",
      "type": "string"
     },
     "ideas": {
      "items": {
       "$ref": "#/components/schemas/NoteIdea"
      },
      "type": "array"
     },
     "markdown": {
      "description": "the whole notes as one Markdown document, sources listed at the end: the export",
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "overview": {
      "type": "string"
     },
     "quiz": {
      "items": {
       "$ref": "#/components/schemas/NoteQuestion"
      },
      "type": "array"
     },
     "sid": {
      "description": "the collection (cid) whose sources they were made from",
      "type": "string"
     },
     "sources": {
      "description": "the source names they were made from, as source_list names them",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "unchecked": {
      "description": "the citation check did not run: the notes are not in English",
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "sid",
     "title",
     "focus",
     "sources",
     "excerpted",
     "model",
     "created_ms",
     "dropped",
     "unchecked",
     "overview",
     "ideas",
     "quiz",
     "essays",
     "glossary",
     "citations",
     "markdown"
    ],
    "type": "object"
   },
   "StudyNotesSummary": {
    "properties": {
     "created_ms": {
      "type": "integer"
     },
     "focus": {
      "type": "string"
     },
     "headings": {
      "description": "the key ideas' headings, in order, for a cover",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "ideas": {
      "description": "how many key ideas",
      "type": "integer"
     },
     "questions": {
      "description": "how many quiz questions",
      "type": "integer"
     },
     "sid": {
      "description": "the collection (cid) whose sources they were made from",
      "type": "string"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "terms": {
      "description": "how many glossary terms",
      "type": "integer"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "sid",
     "title",
     "focus",
     "created_ms",
     "sources",
     "ideas",
     "questions",
     "terms",
     "headings"
    ],
    "type": "object"
   }
  }
 },
 "info": {
  "description": "Study notes of a collection's sources: a written study guide of the key ideas, a quiz with its answers, essay questions and a glossary, every claim cited to its source passage.",
  "title": "NotesService",
  "version": "0.1.0"
 },
 "methods": [
  {
   "description": "Write study notes of a collection's sources. Reads every source whole; takes 10 to 40 seconds.",
   "name": "notes_create",
   "paramStructure": "by-name",
   "params": [
    {
     "name": "req",
     "required": true,
     "schema": {
      "$ref": "#/components/schemas/NotesCreateReq"
     }
    }
   ],
   "result": {
    "name": "result",
    "schema": {
     "$ref": "#/components/schemas/StudyNotes"
    }
   }
  },
  {
   "description": "What notes_create would cost for a collection, before running it. Makes no model call.",
   "name": "notes_estimate",
   "paramStructure": "by-name",
   "params": [
    {
     "name": "sid",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "result": {
    "name": "result",
    "schema": {
     "$ref": "#/components/schemas/NotesEstimate"
    }
   }
  },
  {
   "description": "The study notes of a collection, newest first, as summaries. Use notes_get for the text.",
   "name": "notes_list",
   "paramStructure": "by-name",
   "params": [
    {
     "name": "sid",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "result": {
    "name": "result",
    "schema": {
     "$ref": "#/components/schemas/NotesListResult"
    }
   }
  },
  {
   "description": "Every set of study notes of every collection, newest first, as summaries.",
   "name": "notes_list_all",
   "paramStructure": "by-name",
   "params": [],
   "result": {
    "name": "result",
    "schema": {
     "$ref": "#/components/schemas/NotesListResult"
    }
   }
  },
  {
   "description": "One set of study notes in full, citations included.",
   "name": "notes_get",
   "paramStructure": "by-name",
   "params": [
    {
     "name": "req",
     "required": true,
     "schema": {
      "$ref": "#/components/schemas/NotesRef"
     }
    }
   ],
   "result": {
    "name": "result",
    "schema": {
     "$ref": "#/components/schemas/StudyNotes"
    }
   }
  },
  {
   "description": "Delete a set of study notes. False when there were no such notes.",
   "name": "notes_delete",
   "paramStructure": "by-name",
   "params": [
    {
     "name": "req",
     "required": true,
     "schema": {
      "$ref": "#/components/schemas/NotesRef"
     }
    }
   ],
   "result": {
    "name": "result",
    "schema": {
     "type": "boolean"
    }
   }
  },
  {
   "description": "Rename a set of study notes. False when there were no such notes.",
   "name": "notes_retitle",
   "paramStructure": "by-name",
   "params": [
    {
     "name": "req",
     "required": true,
     "schema": {
      "$ref": "#/components/schemas/NotesRetitleReq"
     }
    }
   ],
   "result": {
    "name": "result",
    "schema": {
     "type": "boolean"
    }
   }
  }
 ],
 "openrpc": "1.3.2"
}