# ─────────────────────────────────────────────────────────────────────────────
# opennotebook — SESSION domain.
#
# Served on the single `rpc.sock` at /api/session/rpc; the matching OpenRPC spec
# is at /api/session/openrpc.json. The byte routes for narration audio and slide
# HTML sit on that same socket under /api/session/audio and /api/session/slide —
# see src/main.rs for why they are not on a second socket.
#
# These types mirror `opennotebook_session::model` field for field. They are a
# second declaration of one shape, which is a cost: the round-trip test in
# tests/surface.rs exists to make a divergence fail rather than drift silently.
# The alternative — deriving the wire types from the Rust ones — is not
# available here, because the macro generates FROM the schema.
#
# Wire method names equal these schema names verbatim.
# ─────────────────────────────────────────────────────────────────────────────

# Addresses one slide on disk: `<collection>/<presentation>/<slide>` under the
# deck root, where `collection` is the session's deck directory.
SlideRef = {
  collection:   str
  presentation: str
  slide:        str
}

# Addresses a DECK: a collection and a presentation, and nothing else.
#
# Separate from SlideRef because `deck_ref` used to be one with a permanently
# empty `slide`, which §4 called out as the same class of lie as a declared
# protocol nothing serves — a field that is always empty teaches a reader to
# ignore it, and a player addressing the deck by it gets nothing. §2 already
# describes this as "collection + presentation".
DeckRef = {
  collection:   str
  presentation: str
}

# Rendered slide dimensions. html slides are 1920x1080, png slides come back
# 1376x768 (1.792:1, not 16:9), so a player mixing both letterboxes.
Aspect = {
  width:  u32
  height: u32
}

# One subtitle-sized span within a line's audio. ALWAYS EMPTY in phase 1 — see
# the phase 1 spec section 2. Declared so a later producer is not a schema
# change; nothing populates it and no caller should expect content.
Cue = {
  at_secs:  f64
  end_secs: f64
  text:     str
}

Speaker = {
  speaker_id:   str # unique within its session
  voice_id:     str # a Kokoro voice id, e.g. af_bella, am_adam
  display_name: str
  role:         str # free text; phase 1 does not interpret it
}

# One spoken line over one slide.
#
# `audio_path` is the studio's own local path and it is deliberately NOT what a
# player fetches: it is unreachable from a browser and it is an absolute path on
# this box. `audio_url` beside it is the route that serves those bytes, and it
# is the field a player reads. Both are present because the path is what the
# prep job wrote and the url is what the surface exposes; a reader that wants
# bytes wants the url.
NarrationLine = {
  line_id:      str
  speaker_id:   str  # REQUIRED, always, even in a one-speaker session
  ordinal:      u32  # explicit; never inferred from position in the list
  text:         str
  audio_path?:  str  # studio-local path to the WAV; absent until synthesised
  audio_url?:   str  # route that serves that WAV; absent until synthesised
  duration_ms?: u64  # measured from the WAV header, never estimated
  cues:         [Cue] # empty in phase 1
}

# One slide and the lines spoken over it.
#
# `slide_url` is the route that serves this slide's rendered HTML, the same way
# `audio_url` serves a line's WAV. The slide bytes are files under the deck
# root, not part of this document; this route reads them on the caller's
# behalf so a player needs no file access of its own.
SessionSlide = {
  slide_ref: SlideRef
  ordinal:   u32
  aspect:    Aspect
  slide_url: str
  title:     str  # the part's heading: the slide's title, or an audio overview's chapter
  lines:     [NarrationLine]
}

# What makes a session an audio overview. See docs/audio-overview-spec.md.
AudioOverview = {
  format:  str  # "deep_dive" | "brief" | "critique" | "debate"
  length:  str  # "shorter" | "default" | "longer"
  focus:   str  # what the person asked it to centre on; empty when nothing
  minutes: u32  # about how long it was written to run
}

# A whole session.
#
# `speaker_count` is NOT a field. It is `speakers` length, and a stored count
# can disagree with the speakers present — two fields describing one fact.
Session = {
  sid:             str  # names the session directory and the memory collection too
  title:           str
  collection_name: str
  collection_sid?: str  # unused, kept so older rows decode; a collection is deleted by name
  deck_ref?:       DeckRef
  speakers:        [Speaker]
  slides:          [SessionSlide]
  state:           str  # "preparing" | "ready" | "failed"
  prep_job_sid?:   str  # the job that prepared this session
  # Why a failed session failed, and the job whose log carries the detail.
  # Present only when `state` is "failed". The state alone cannot separate an
  # exhausted provider quota from a theme collision from an unreadable source,
  # and a caller that shows one fixed sentence for all three is guessing.
  failure?:        str  # reason a "failed" session failed, with its prep job sid
  audio?:          AudioOverview # present for an audio overview, which has chapters and no slides
  # The collection this output belongs to: the cid whose sources it was built
  # from. Absent on a session made before collections, which is then a
  # collection of its own under its own sid.
  collection?:     str
  # What the prep's model calls cost, in USD: each call's provider-reported
  # cost, or its tokens at the catalog price. Absent when not known: a session
  # prepared before this was recorded, or one with a call priced neither way.
  # Every model call of the prep is in it: web research, the Q&A extraction
  # that indexes the sources, the script and the slides.
  spent_usd?:      f64
  style?:          str  # the slide style id a deck was built in; absent for an audio overview and older rows. A retry passes it back as `style`.
}

# Reading one session.
#
# `session_get` takes a BARE SCALAR rather than a one-field request type. Both
# were tried: a named single-field `SessionGetReq` made the macro emit an input
# struct referencing a type it never generated, and the expansion failed with
# "cannot find type `SessionGetReq` in this scope". A bare scalar is one of the
# three documented param forms (phase 1 spec section 1) and it is named by its
# parameter on the wire: {"sid": "..."}.
#
# `found` is the discriminator and it is separate from `session` on purpose.
# Absence is a missing row, and a caller should never have to infer it from
# an empty value: read `found`, never the emptiness of `session`.
SessionGetResult = {
  found:    bool     # the discriminator; never infer absence from `session`
  session?: Session
}

# Listing sessions. Summaries rather than whole documents: a session carries
# every line of narration and a list of them would be megabytes.
SessionSummary = {
  sid:         str
  title:       str
  state:       str
  slide_count: u32  # slides of a session, chapters of an audio overview
  speakers:    u32
  kind:        str  # "session" for a narrated slide session, "audio" for an audio overview
  audio_format: str # an audio overview's format id; empty for a session
  duration_ms: u64  # the narration's length, from its measured lines; 0 before it is synthesised
  # The opening line of narration, as a preview of what the session covers.
  #
  # Not a separate authored field: nothing writes one, and a summary that
  # invented one would be the studio describing itself rather than the material.
  # Empty before the script exists, which is every session that has not finished
  # preparing.
  description: str
  # Milliseconds since the epoch, derived from the sid where the sid carries a
  # timestamp, which is true of every sid the studio mints. 0 when it cannot be
  # read: a hand-named session has no creation time anywhere, and guessing one
  # would be worse than saying nothing.
  created_ms:  u64
  # Whether the person put this session in the featured row themselves.
  #
  # A gallery ordered only by recency buries the session someone actually works
  # in the moment they make a newer one. Pinning is that person saying which
  # ones matter; the featured row fills its remaining places with the most
  # recent, so an unpinned gallery still has one.
  pinned:      bool
  # The collection this output belongs to. Always filled: a session made
  # before collections reports its own sid, since it is its own collection.
  collection:  str
  # What the prep spent on model calls, in USD; see Session.spent_usd. 0 when
  # not known, which `spent_known` tells apart from a build that cost nothing.
  spent_usd:   f64
  spent_known: bool # false for a session prepared before spend was recorded, or not fully priced
}

SessionListResult = {
  sessions: [SessionSummary]
}

# Submitting a prep run as a job.
#
# This RETURNS as soon as the job row exists. Preparing a session takes minutes
# — 20 to 37 s per slide to render plus 4.4 to 5.7 s per line to synthesise —
# so it is a job with progress, never a request anyone waits on. Poll
# session_get with the returned sid.
SessionPrepareReq = {
  sid:           str    # must be unique per workspace: it names the session directory AND the memory collection
  title:         str
  resource_dir:  str    # directory of user resources to ingest
  speakers:      [Speaker] # empty takes the voices from the studio settings, as session_build does
  slide_count?:  u32    # a deck's slides, 3 to 12 (outside is clamped); absent takes the studio setting. Ignored for an audio overview.
  # The look of the deck: one of `opennotebook_sdk::styles::STYLES`' ids, e.g.
  # "vector" or "watercolor". Absent, empty, or an id this build does not know
  # falls back to the studio's style setting. It is an id and not a theme
  # name because the theme does not exist yet: the prep writes one per
  # session from the style's brief.
  style?:        str
  # What to research on the web before the prep reads its sources, in the
  # person's own words. Present and non-empty turns the research step on:
  # the prep searches and reads the web on it, and its report becomes one
  # more source beside whatever the person added. Absent or empty, the prep
  # reads only what was staged.
  research_topic?: str
  # Present to make an audio overview instead of a slide session: no slides,
  # the parts become chapters. "deep_dive", "brief", "critique" or "debate".
  audio_format?: str
  audio_length?: str  # "shorter" | "default" | "longer"; absent takes the studio setting; a length the format does not offer becomes "default"
  focus?:        str  # what to centre the audio overview on, in the person's words
  # The collection whose sources this output is built from. Present, an empty
  # resource_dir means that collection's staged sources rather than the sid's,
  # and the row records it. Absent, the sid is its own collection, as before
  # collections existed.
  collection?:   str
}

# What a prepare call returns. `accepted` says the job row was created, NOT that
# the session prepared: read the session's `state` for that. Reaching
# steps_total does not imply success either.
SessionPrepareResult = {
  accepted:     bool
  sid:          str
  prep_job_sid: str  # the job row the prep runs as
}

# ── the gallery's own edits ───────────────────────────────────────────────────
#
# Three things a person can do to a session without rebuilding it. They are
# separate methods rather than one `session_update` taking a patch: a patch type
# with every field optional cannot say which absence means "leave it" and which
# means "clear it", and the three have nothing in common but the sid.

# Renaming. The title is the one thing in a session a person authored, and the
# model's guess at it is often wrong in a way only they can fix.
SessionRetitleReq = {
  sid:   str
  title: str  # trimmed; empty is refused rather than stored, since a session with
              # no title is unfindable in a gallery that lists by title
}

# Pinning, both directions. `pinned: false` unpins — not a separate method,
# because the button is a toggle and two methods would let the two drift.
SessionPinReq = {
  sid:    str
  pinned: bool
}


# ── playback ─────────────────────────────────────────────────────────────────

# Where a session is and whether it is moving.
#
# `offset_ms` is a FREE millisecond value inside `line_id`, not a line index.
# §5 requires pause at an arbitrary offset and requires the offset to be
# recorded, because phase 2 pauses on a keypress mid-line; a player that can only
# stop between lines is one phase 2 rewrites. Building it now is a parameter,
# retrofitting it is a rewrite.
Playhead = {
  slide_ordinal: i64
  line_id:       str  # "" before the first line starts
  offset_ms:     i64  # arbitrary, inside line_id
  state:         str  # "idle" | "playing" | "paused" | "finished"
}

# One position, used by every playback call that moves or reports the playhead.
#
# The browser sends where it actually is rather than the studio inferring it from
# a timer: the audio element is the only clock that knows what was really heard,
# and a studio-side timer would drift from it.
PlaybackAtReq = {
  sid:           str
  slide_ordinal: i64
  line_id:       str
  offset_ms:     i64
}

# ─────────────────────────────────────────────────────────────────────────────
# SESSION domain service.
# ─────────────────────────────────────────────────────────────────────────────

# A build from a collection's sources, with the studio's defaults for whatever is not
# given. The one call an agent needs after gathering sources.
SessionBuildReq = {
  # The output's own id. With `collection` given it is a fresh id for this one
  # output (empty mints one); without it, it is the collection id the sources
  # were added to, and the output takes that id, as before collections.
  sid:          str
  collection?:  str  # the collection (cid from collection_create) whose sources to build from
  title?:       str  # the output's title, a few words; absent, the collection's title, or "Narrated slides" / "Audio overview" while it has none
  speakers?:    u32  # 1 for one narrator, 2 for a narrator and an expert in conversation; the studio setting when absent
  slide_count?: u32  # how many slides, 3 to 12 (outside is clamped); the studio setting when absent
  style?:       str  # a style id from styles_list; the studio setting when absent
  audio_format?: str # make an audio overview instead: "deep_dive", "brief", "critique" or "debate"
  audio_length?: str # "shorter" | "default" | "longer"; the studio setting when absent
  focus?:        str # what to centre the audio overview on
}

# One step of a build and what it costs. Every step is listed, free ones too.
CostLine = {
  group:                 str  # the phase: reading sources, script, slides, narration
  step:                  str  # what the step does, in a few words
  detail:                str  # how the count was reached, in plain words
  model:                 str  # the model it calls; empty when it calls none
  via:                   str  # which service makes the call, and through what
  calls_low:             u64
  calls_typical:         u64
  calls_high:            u64
  input_tokens:          u64  # measured from the sources and prompts (typical case)
  output_tokens_low:     u64
  output_tokens_typical: u64
  output_tokens_high:    u64
  cost_low_usd:          f64
  cost_typical_usd:      f64
  cost_high_usd:         f64
  free:                  bool # runs locally or makes no call
  unpriced:              bool # the model has no price in the catalog; counted as 0
  price_in_per_million?:  f64 # USD per million input tokens
  price_out_per_million?: f64 # USD per million output tokens
}

SessionEstimateResult = {
  total_low_usd:     f64
  total_typical_usd: f64
  total_high_usd:    f64
  lines:             [CostLine]
  assumptions:       [str]  # what was measured, what was estimated, what is not included
  sources:           u64
  source_chars:      u64
  slides:            u64
  speakers:          u64
  style:             str
  slides_tier:       str    # the model that writes the slides, e.g. anthropic/claude-haiku-4.5
  priced_at:         str    # when the prices were read, RFC 3339
  minutes:           u64    # about how long the session's narration will run
  limit_usd:         f64    # the studio's spending limit per session; 0 when there is none
  over_limit:        bool   # the high estimate is over the limit, so a build would be refused
}

# ── collections ──────────────────────────────────────────────────────────────
#
# A collection is one set of sources and everything made from them: narrated
# slide decks, audio overviews, mind maps and study notes, as many of each as
# the person asks for. Its id (cid) is the staging id the sources are added
# under, so mind maps and notes, which were always keyed by it, belong to it
# with no change. A deck or an audio overview is a session row of its own whose
# `collection` names the cid.
#
# A session made before collections has no `collection`; it is listed as a
# collection of its own under its own sid, with whatever maps and notes were
# made from the same sources. So is a staging directory with sources and no
# row, which is a draft from before collections. Such a collection gets a row
# the first time it is renamed, pinned or added to, with the title and pin it
# was already listed with.

Collection = {
  cid:        str
  # Empty until there is something to name it from. While `title_auto` is true
  # the studio names it itself from its sources, in the background a few
  # seconds after they change, and names it again whenever a source is added or
  # removed; a title the person typed is never replaced.
  title:      str
  title_auto: bool
  created_ms: u64
  updated_ms: u64   # the last time a source or an output was added or changed
  pinned:     bool
}

# A collection as a list shows it: the record and what is in it.
CollectionSummary = {
  cid:        str
  title:      str
  title_auto: bool
  created_ms: u64
  updated_ms: u64
  pinned:     bool
  sources:    u32   # staged sources
  decks:      u32   # narrated slide sessions, any state
  audios:     u32   # audio overviews, any state
  maps:       u32
  notes:      u32
  preparing:  u32   # decks and audio overviews still being made
  failed:     u32
  # Changes whenever the drawn cover does; never empty. The cover itself is
  # GET /api/session/cover?collection=<cid>&v=<cover_version>, a self-contained
  # 16:9 HTML page (1600x900 canvas): designed by a model from what the
  # collection holds, or drawn from its cid and title until then.
  cover_version: str
}

CollectionCreateReq = {
  title?: str  # what the person called it; absent or empty and the studio names it from its sources
}

CollectionListResult = {
  collections: [CollectionSummary]  # most recently updated first
}

CollectionGetResult = {
  found:      bool
  collection?: CollectionSummary
  outputs:    [SessionSummary]  # its decks and audio overviews, newest first; maps and notes are mindmap_list / notes_list on the cid
}

CollectionRetitleReq = {
  cid:   str
  title: str  # trimmed; empty hands the naming back to the studio
}

CollectionPinReq = {
  cid:    str
  pinned: bool
}

SessionAskReq = {
  sid:            str  # a built session
  question:       str  # what the listener wants to know, in their words
  slide_ordinal?: u32  # the slide they were on (0-based), so the answer can start from it
}

SessionAskResult = {
  answer: str # a short spoken-style answer grounded in the session's sources
}

service SessionService {
  version:     "0.1.0"
  description: "Narrated slide sessions: build one from gathered sources, follow the build, read, list and manage sessions, ask questions about one, and drive playback."

  collection_create(req: CollectionCreateReq)   -> Collection           # Start a collection: an empty set of sources to add to (see the sources tools, with the cid as sid) and build outputs from. The title is optional.
  collection_list()                             -> CollectionListResult # Every collection, most recently updated first, with counts of its sources and outputs.
  collection_get(cid: str)                      -> CollectionGetResult  # One collection and its decks and audio overviews. Check `found` first.
  collection_retitle(req: CollectionRetitleReq) -> bool                 # Rename a collection; an empty title lets the studio name it. False when there was no such collection.
  collection_pin(req: CollectionPinReq)         -> bool                 # Pin or unpin a collection. False when there was no such collection.
  collection_cover_refresh(cid: str)            -> bool                 # Design the collection's cover again now, from what it holds, even if nothing changed. Returns once it is drawn; with covers off in Settings no model is asked. False when there was no such collection.
  collection_delete(cid: str)                   -> bool                 # Delete a collection with its sources and everything made from them: its decks and audio overviews as session_delete removes one, its maps and notes. A job still preparing one is stopped. False when there was no such collection.

  session_build(req: SessionBuildReq)     -> SessionPrepareResult # Build a narrated slide session or an audio overview from a collection's sources: pass `collection` and an empty sid, and call it as often as you like for more outputs. Takes minutes; poll session_get with the returned sid until state is ready or failed.
  session_get(sid: str)                   -> SessionGetResult     # One session in full: state (preparing, ready, failed), title, slides and every narration line. Check `found` first.
  session_list()                          -> SessionListResult    # Every session, newest first, as summaries (sid, title, state, slide count). Use session_get for the full content.
  session_estimate(req: SessionBuildReq)  -> SessionEstimateResult # What session_build would cost with the same arguments, before running it: every step, its model, tokens and a low/typical/high price in USD. Makes no model call.
  session_ask(req: SessionAskReq)         -> SessionAskResult     # Ask a question about a built session and get a short answer grounded in its sources.
  session_prepare(req: SessionPrepareReq) -> SessionPrepareResult # Low-level build with every parameter explicit (speakers with voices, a resource directory on the server). Prefer session_build.

  session_delete(sid: str)                -> bool # Delete a session (a deck or an audio overview): its row, then its deck, audio and memory collection, best effort. A prep still running is stopped. False when there was no such session.
  session_retitle(req: SessionRetitleReq) -> bool # Rename a session. False when there was no such session.
  session_pin(req: SessionPinReq)         -> bool # Pin or unpin a session in the gallery. False when there was no such session.

  # Playback. The studio holds the playhead; a player obeys the event stream at
  # /api/session/events and reports its own clock back through these.
  playback_get(sid: str)                  -> Playhead # Where a session's playback is now: slide, line and offset, playing or paused.
  playback_play(req: PlaybackAtReq)       -> Playhead # Start or resume playback at a position.
  playback_pause(req: PlaybackAtReq)      -> Playhead # Pause playback, recording the exact position.
  playback_progress(req: PlaybackAtReq)   -> Playhead # For players: report the current position while playing.
  playback_finish(sid: str)               -> Playhead # For players: the last line of the last slide has ended.
}
