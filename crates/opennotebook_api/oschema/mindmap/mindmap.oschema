# ─────────────────────────────────────────────────────────────────────────────
# opennotebook — MINDMAP domain.
#
# A map of the topics a collection's sources cover. Served at /api/mindmap/rpc, and
# each method's comment is written for an agent reading
# the method list. The design is docs/mindmap-spec.md.
#
# The tree is NotebookLM's shape, {name, children}, with no children on a leaf.
# MindNode refers to itself; the generated Rust type holds its children in a
# Vec, so the recursion needs no indirection.
# ─────────────────────────────────────────────────────────────────────────────

MindNode = {
  name:     str
  children: [MindNode] # empty on a leaf
}

MindMap = {
  id:         str        # a UUID, the map's own address; maps made before UUIDs keep their m<digits> id
  sid:        str        # the collection (cid) whose sources it maps
  title:      str        # the root's name, until somebody renames the map
  focus:      str        # what the person asked it to centre on; empty when nothing
  sources:    [str]      # the source names it was built from, as source_list names them
  excerpted:  bool       # the sources were too long to send whole and were cut to excerpts
  model:      str
  created_ms: u64
  node_count: u32
  dropped:    u32        # nodes removed because the sources never mention them
  unchecked:  bool       # the check against the sources did not run: the map is not in English
  root:       MindNode
}

MindMapSummary = {
  id:         str
  sid:        str  # the collection (cid) whose sources it maps
  title:      str
  focus:      str
  node_count: u32
  created_ms: u64
  sources:    [str]
  shape:      [u32] # how many subtopics each main topic has, in order: the outline of the tree, for a cover
}

MindMapListResult = {
  maps: [MindMapSummary] # newest first
}

MindMapCreateReq = {
  sid:      str    # a collection's cid, from collection_create
  focus?:   str    # a topic to centre the map on, in the person's words
  sources?: [str]  # source names from source_list; every source when absent
}

MindMapRef = {
  sid: str
  id:  str
}

MindMapRetitleReq = {
  sid:   str
  id:    str
  title: str  # the new name, trimmed; empty is refused
}

# What mindmap_create would cost, before it runs. One model call over the
# sources' whole text; a second one only when the first map is too thin.
MindMapEstimate = {
  sources:       u32
  chars:         u64  # readable text across the sources
  model:         str
  input_tokens:  u64  # estimated at four characters a token, prompt included
  output_tokens: u64  # a typical map; the measured ones ran 20 to 75 nodes
  cost_usd:      f64  # one call, the usual case
  cost_high_usd: f64  # two calls, when the first map comes back too thin
  priced:        bool # false when the price catalog had no price for the model; the costs are then 0
}

service MindMapService {
  version:     "0.1.0"
  description: "Mind maps of a collection's sources: the topics they cover as a tree, to see the whole of the material and pick what to ask about."

  mindmap_create(req: MindMapCreateReq) -> MindMap           # Map the topics a collection's sources cover. Reads every source whole; takes a few seconds. Ask about a topic with source_ask.
  mindmap_estimate(sid: str)            -> MindMapEstimate   # What mindmap_create would cost for a collection, before running it. Makes no model call.
  mindmap_list(sid: str)                -> MindMapListResult # The mind maps of a collection, newest first, as summaries. Use mindmap_get for the tree.
  mindmap_list_all()                    -> MindMapListResult # Every mind map of every collection, newest first, as summaries.
  mindmap_get(req: MindMapRef)          -> MindMap           # One mind map in full, tree included.
  mindmap_delete(req: MindMapRef)       -> bool              # Delete a mind map. False when there was no such map.
  mindmap_retitle(req: MindMapRetitleReq) -> bool            # Rename a mind map. False when there was no such map.
}
