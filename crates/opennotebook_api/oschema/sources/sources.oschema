# ─────────────────────────────────────────────────────────────────────────────
# opennotebook — SOURCES domain.
#
# What a collection's outputs are made from. Served at /api/sources/rpc. The
# comment after each method is written for an agent reading the method list:
# what it does, when to call it, what to pass on to the next call.
#
# The flow an agent follows:
#   collection_create (session domain) → web_search → source_add_urls /
#   source_add_text / source_add_file / deep_research with the cid as `sid` →
#   source_list to check
#   → session_build{collection: cid, sid: ""} (session domain) as many times as
#   wanted, decks and audio overviews mixed → session_get on each returned sid
#   to poll → mindmap_create / notes_create with the cid as `sid`.
#
# The `sid` every method here takes is a collection's cid: the name is older
# than collections. draft_create still works and makes an untitled collection.
# A source added to a cid with nothing under it makes that collection.
# ─────────────────────────────────────────────────────────────────────────────

# One source that is part of a collection.
Source = {
  name:  str # the stored file name; pass it to source_remove
  title: str # the page or note title
  url:   str # where it was read from; empty for a pasted note or a research report
  chars: u64 # length of the readable text
}

# The outcome of reading one page or keeping one note.
SourceAddResult = {
  url:   str  # the page asked for; empty for a note or a file
  ok:    bool # true when it was added as a source
  title: str
  chars: u64  # readable text kept; a few hundred means a thin page
  error: str  # why it was NOT added (unreadable, blocked, refused); empty when ok
}

SourceAddUrlsReq = {
  sid:  str   # a collection's cid, from collection_create
  urls: [str] # up to 8 http(s) links; each is opened in a real browser and read
}

SourceAddUrlsResult = {
  added:   u32               # how many became sources
  results: [SourceAddResult] # one per url, in order, failures included
}

SourceAddTextReq = {
  sid:    str  # a collection's cid, from collection_create
  text:   str  # the note itself, in plain text or Markdown; at least a paragraph
  title?: str  # a name for it; the first words of the text when absent
}

SourceAddFileReq = {
  sid:         str # a collection's cid, from collection_create
  name:        str # the file's name with its extension, which picks how it is read: pdf, docx, pptx, xlsx, md, markdown, txt or csv
  data_base64: str # the file's bytes in standard base64; at most 25 MB before encoding
}

SourceListResult = {
  sources: [Source]
}

SourceRemoveReq = {
  sid:  str # a collection's cid
  name: str # a source name from source_list
}

WebSearchHit = {
  title:   str
  url:     str # pass the best ones to source_add_urls
  snippet: str
}

WebSearchResult = {
  hits: [WebSearchHit]
}

DeepResearchReq = {
  sid:   str # a collection's cid, from collection_create
  topic: str # what to research, in plain words
}

# One passage an answer drew on, numbered as the answer numbers it.
Citation = {
  n:       u32 # the number in the answer's text: [1], [2]
  name:    str # the source's file name, as source_list names it
  title:   str
  url:     str # where the source was read from; empty for a note or a research report
  excerpt: str # the passage itself
}

SourceAskReq = {
  sid:      str   # a collection's cid, from collection_create
  question: str   # in the person's words
  sources?: [str] # source names from source_list; every source when absent
}

SourceAskResult = {
  answer:    str        # Markdown, with [n] markers after the claims
  citations: [Citation] # only the ones the answer cites, in order of first use
}

service SourcesService {
  version:     "0.1.0"
  description: "Gather the material a collection's decks, audio overviews, mind maps and notes are made from: search the web, add pages, notes or files, check what is there, and ask what it says."

  draft_create()                               -> str                 # Start a new, untitled collection to collect sources in (the same as collection_create with no title). Returns its cid: pass it as sid to every source_* call, and as collection to session_build.
  source_add_urls(req: SourceAddUrlsReq)       -> SourceAddUrlsResult # Read web pages into a collection as sources. Each result says whether that page was added and, if not, why; replace a failed page with another search result.
  source_add_text(req: SourceAddTextReq)       -> SourceAddResult     # Add a pasted note or any text you already have to a collection as a source.
  source_add_file(req: SourceAddFileReq)       -> SourceAddResult     # Add a document to a collection as a source: PDF, Word, PowerPoint, Excel, Markdown, text or CSV, sent as base64. It is read into text and titled by its file name; the result says why when it could not be read.
  source_list(sid: str)                        -> SourceListResult    # List the sources in a collection, to check what its outputs will be made from.
  source_remove(req: SourceRemoveReq)          -> bool                # Remove one source from a collection by its name; false when there was no such source.
  web_search(query: str)                       -> WebSearchResult     # Search the web and return result pages (title, url, snippet). Nothing is added: pass the best urls to source_add_urls.
  deep_research(req: DeepResearchReq)          -> SourceAddResult     # Research a broad topic in depth (reads many pages; about a minute at Quick depth, a few at Standard, per the Web research depth setting) and add the written report to a collection as one source.
  source_ask(req: SourceAskReq)                -> SourceAskResult     # Answer a question from a collection's sources, citing the passages each claim rests on. Use it whenever the person asks what their material says.
}
