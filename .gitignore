# Rust build artifacts.
# No trailing slash on purpose: a trailing slash matches directories ONLY, so a
# symlink named `target` slips through and gets committed.
target

__pycache__/

# Python and web app.
.venv/
.pytest_cache/
.ruff_cache/
node_modules/
web/dist/
*.tsbuildinfo
.env
web/test-results/
web/playwright-report/
