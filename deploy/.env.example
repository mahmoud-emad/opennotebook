# OpenNotebook's production settings. Copy this file to deploy/.env and fill
# it in; deploy/.env is never committed. compose.yaml reads it twice: for its
# own values (the ports, the domain, the database password) and as the
# environment of the api, the worker and the migrate step.
#
# A line left commented out keeps the default shown. An empty value is not
# the same as a missing one for every setting, so uncomment only what you set.

# ── Caddy ─────────────────────────────────────────────────────────────────────

# The studio's public name, such as notes.example.com. Set, Caddy gets a
# certificate for it and serves HTTPS (ports 80 and 443 must reach this
# machine). Empty, the studio is plain HTTP on HTTP_PORT.
DOMAIN=
# The ports on this machine Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443
# The address people open, for CORS: https://notes.example.com, or
# http://localhost when there is no domain.
PUBLIC_URL=http://localhost

# ── Database ──────────────────────────────────────────────────────────────────

# The password of the bundled Postgres. Required. Make one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# The database the server uses. Leave unset to use the bundled Postgres; set
# it to use another one (postgresql://user:password@host:5432/name). The
# database needs the pgvector extension available.
# DATABASE_URL=

# ── AI ────────────────────────────────────────────────────────────────────────

# The OpenAI-compatible endpoint every model call goes to, and its key. Without
# a key the studio runs, but nothing that needs a model does.
# OPENNOTEBOOK_AI_BASE_URL=https://openrouter.ai/api/v1
OPENNOTEBOOK_AI_KEY=
# The embedding model for search; empty means search uses words only.
# OPENNOTEBOOK_EMBED_MODEL=

# The model each kind of work uses. These are the operator's defaults; a
# person can still pick another in Settings.
# OPENNOTEBOOK_CHAT_MODEL=google/gemini-2.5-flash-lite
# OPENNOTEBOOK_SCRIPT_MODEL=anthropic/claude-haiku-4.5
# OPENNOTEBOOK_SLIDE_MODEL=anthropic/claude-haiku-4.5
# OPENNOTEBOOK_ANSWER_MODEL=openai/gpt-audio-mini
# OPENNOTEBOOK_MINDMAP_MODEL=google/gemini-2.5-flash-lite
# OPENNOTEBOOK_NOTES_MODEL=google/gemini-2.5-flash-lite
# OPENNOTEBOOK_SEARCH_MODEL=perplexity/sonar
# OPENNOTEBOOK_QA_MODEL=openai/gpt-4o-mini

# ── Sign-in ───────────────────────────────────────────────────────────────────

# `local`: every request without a key is the one owner below, for a studio
# run by one person. `keys`: every request needs an API key.
# OPENNOTEBOOK_AUTH=local
# OPENNOTEBOOK_LOCAL_OWNER_EMAIL=owner@localhost

# ── Speech ────────────────────────────────────────────────────────────────────

# Who reads lines aloud: `edge` (the default) uses Microsoft's neural voices
# through the free Edge Read Aloud service, with no key; `azure` uses the same
# voices through Azure Speech, with a key, for production; `openai` uses the
# OpenAI-compatible speech server below (Speaches or Kokoro-FastAPI with
# Kokoro's voices, or OpenAI). Settings › Voices offers the provider's voices.
# OPENNOTEBOOK_TTS_PROVIDER=edge
# Azure Speech's key and the region it was made in (westeurope, eastus, …).
# The key is a secret: set it here, never in Settings.
# OPENNOTEBOOK_AZURE_SPEECH_KEY=
# OPENNOTEBOOK_AZURE_SPEECH_REGION=

# The OpenAI-compatible speech server: it reads aloud when the provider is
# `openai`, and it turns spoken questions into text whatever the provider.
# compose.yaml points it at the bundled Speaches (`--profile speech`); set it
# to use another one. Speech-to-text uses the same server unless
# STT_BASE_URL says otherwise.
# OPENNOTEBOOK_TTS_BASE_URL=http://speech:8000/v1
# OPENNOTEBOOK_STT_BASE_URL=
# OPENNOTEBOOK_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# OPENNOTEBOOK_STT_MODEL=Systran/faster-whisper-small
# The speech server's key, when it asks for one.
# OPENNOTEBOOK_SPEECH_API_KEY=

# ── Studio defaults ───────────────────────────────────────────────────────────

# The defaults every person starts from, until they change them in Settings.
# Settings shows the accepted values for each.
# OPENNOTEBOOK_STYLE=
# OPENNOTEBOOK_SLIDE_COUNT=
# OPENNOTEBOOK_SESSION_MINUTES=
# OPENNOTEBOOK_AUDIO_FORMAT=
# OPENNOTEBOOK_AUDIO_LENGTH=
# OPENNOTEBOOK_RESEARCH_DEPTH=
# OPENNOTEBOOK_AUTO_NAME=
# OPENNOTEBOOK_COVERS=
# OPENNOTEBOOK_SPEAKER_COUNT=
# OPENNOTEBOOK_SPEAKER1_NAME=
# OPENNOTEBOOK_SPEAKER1_VOICE=
# OPENNOTEBOOK_SPEAKER1_ROLE=
# OPENNOTEBOOK_SPEAKER2_NAME=
# OPENNOTEBOOK_SPEAKER2_VOICE=
# OPENNOTEBOOK_SPEAKER2_ROLE=
# OPENNOTEBOOK_LANGUAGE=
# OPENNOTEBOOK_ANSWER_LENGTH=
# OPENNOTEBOOK_TURN_PATIENCE=
# OPENNOTEBOOK_INTERRUPT=
# OPENNOTEBOOK_COURTESY=
# The most one build may spend, in US dollars.
# OPENNOTEBOOK_MAX_BUILD_USD=
# OPENNOTEBOOK_SHOW_COST=
